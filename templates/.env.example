# web-deploy-env Configuration
# Copy this file to .env and fill in your values.
#
# Infrastructure variables:
#   DOMAIN, TUNNEL_TOKEN — used directly by docker-compose.yml and Caddyfile
#
# All other variables in .env are forwarded to the webapp container
# via env_file: .env (docker-compose.yml). Add any application-specific
# variables your project needs — the template does not require them.

# Your domain name (e.g., app.yourdomain.com)
DOMAIN=yourdomain.com

# Cloudflare Tunnel token (generated in Zero Trust dashboard)
TUNNEL_TOKEN=your_cloudflare_tunnel_token
